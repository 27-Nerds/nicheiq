# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-5-mini        # Default agent reasoning (gpt-5-mini: $0.25/M, 400K context)
FUNCTION_CALLING_LLM=gpt-5-nano     # Tool/function calls (gpt-5-nano: $0.05/M, fast & cheap)
CONTENT_ANALYSIS_LLM=gpt-4.1-mini   # Content analysis (gpt-4.1-mini: $0.40/M, 1M context for large Reddit content)
THREAD_VALIDATION_LLM=gpt-5-nano    # Thread relevance validation (gpt-5-nano: $0.05/M, binary decisions)
STANCE_VALIDATION_LLM=openrouter/deepseek/deepseek-v4-flash:nitro  # Pain-point quote stance gate. NOT a cheap-classifier slot any more: pre-gate ranking was removed, so this gate is the PRIMARY evidence selector and judges every candidate (hundreds/pain, in concurrent chunks of 300). Measured on the 123-case oracle: combined precision mercury-2 0.52 / grok-4.3 0.66 / deepseek-flash 0.69 / terra 0.78. deepseek chosen for cost; swap to gpt-5.6-terra if precision matters more than spend. Needs reasoning_effort=none.
# ENABLE_FIRSTPERSON_QUERIES=true   # Rewrite pains into first-person retrieval queries before quote search (register-matched to forum text: 70% -> 84% recall of known-missing evidence at identical query count). Fail-soft to analyst voice.
# QUERY_VARIANT_LLM=openrouter/deepseek/deepseek-v4-flash:nitro  # Generates those queries. ONE batched call per run (~$0.001).
# NICHE_CONTEXT_LLM=openrouter/google/gemini-3.1-flash-lite  # Stage-1 niche+audience-scope classifier (first-party structured tier; default). Was qwen3-235b (empty finish_reason=stop crash on guided-json).
BRAINSTORM_LLM=gpt-5.2              # Solution brainstorming — CREATIVE tier (divergent gen + ideator)
BRAINSTORM_REASONING_EFFORT=medium  # Creative tier depth (none/minimal/low/medium/high/xhigh) - the only working creativity lever on reasoning models
# Divergent-ideation diversity (reduces duplicate / theme-clustered ideas):
# BRAINSTORM_LLMS=                  # Comma-separated MODEL POOL round-robined across divergent samples for MODEL DIVERSITY.
#                                   # Empty => use BRAINSTORM_LLM for every sample. Use decorrelated, REASONING-GRADE models
#                                   # (the divergent prompt is dense; weak models under-comply). Set NUM_DIVERGENT_SAMPLES >= pool size.
#                                   # Each entry MAY carry an inline '@<effort>' to set THAT model's reasoning effort
#                                   # (none/minimal/low/medium/high/xhigh); entries without '@' inherit BRAINSTORM_REASONING_EFFORT.
#                                   # This matters: with reasoning ON + a forced tool_choice some models (e.g. DeepSeek) leak the
#                                   # tool call into the 'reasoning' channel / under-generate -> use '@none'; Kimi needs '@medium'.
#                                   # e.g. openrouter/moonshotai/kimi-k2.6@medium,openrouter/deepseek/deepseek-v4-pro@none,openrouter/z-ai/glm-5.2@medium
# NUM_DIVERGENT_SAMPLES=2           # Independent divergent calls pooled before filtering (cost scales linearly; raise to >= pool size to use all models)
# DIVERGENT_SAMPLE_DEADLINE_SECONDS=360  # Wall-clock cap for the parallel divergent fan-out; a runaway sample (reasoning model held open by OpenRouter keep-alive, which the read-timeout can't cap) is abandoned and the pool proceeds with what finished
# DIVERGENT_KEEP_FRACTION=0.5        # Keep at least this fraction of GENERATED concepts through the first dedup/clamp (floored at 6 so a single-model pool isn't starved, capped at DIVERGENT_POOL_CAP). Raise to send more candidates to the LLM diversity filter.
# DIVERGENT_POOL_CAP=15             # Ceiling on concepts kept after dedup (RawConceptList max 15). Actual count scales with DIVERGENT_KEEP_FRACTION; this is just the upper bound.
# DIVERGENT_DEDUP_SIMILARITY_THRESHOLD=0.85  # Embedding cosine threshold for SEMANTIC dedup of pooled concepts (name+one_liner+why_non_obvious).
#                                   # >= this => near-duplicate, keep the most-novel. Catches cross-model/cross-wording dups the name/tag dedup misses.
#                                   # 0.0 disables; raise toward 0.90 for fewer merges. Embeddings always use OpenAI (no OpenRouter endpoint).
# Pain-partitioned divergent ideation: ONE narrow generator per selected pain (persona-grounded from the
# real audience segments), ~3 concepts each. Guarantees pain coverage by construction + breaks idea
# clustering. When ON it REPLACES the N-broad-sample path; falls back to it automatically if < 2 pains.
# ENABLE_PAIN_PARTITIONED_DIVERGENT=false  # set true to use the partitioned path
# DIVERGENT_MAX_GENERATORS=8               # cap on generators (~1 per diverse pain); 5-8 is the sweet spot
# DIVERGENT_MAX_WORKERS=8                   # parallel generator threads in partitioned mode (legacy path stays 4)
# DIVERGENT_PARTITIONED_KEEP_FRACTION=0.67  # keep-fraction for the partitioned path (narrow concepts dedup less)
# Diversity-aware final selection (default OFF — keep more ideas, de-concentrate the final set):
# ENABLE_DIVERSITY_CAPS=false       # raise final count toward DIVERSITY_MAX_FINAL_IDEAS + per-segment/mechanism/project-type caps (drop-only, floor-protected, bold + sole-coverage protected)
# ENABLE_PAIN_SOURCE_DEDUP=false    # collapse same-pain + same-data-source near-dups the M/D/J gate misses
# DIVERSITY_MAX_FINAL_IDEAS=10      # ceiling on the Stage-1 selection set (caps make ~6-8 typical)
# DIVERSITY_MIN_FINAL_IDEAS=5       # floor: re-admit best dropped ideas (least-represented bucket first) to here
# DIVERSITY_MAX_PER_SEGMENT=2       # max ideas per source_segment
# DIVERSITY_MAX_PER_MECHANISM=2     # max ideas per mechanism family (greedy pairwise via _tags_match)
# DIVERSITY_MAX_PER_PROJECT_TYPE=3  # lenient (info-products first-class); set 2 to force type-spread
# SEO-realism caps (always on — downgrade-only; never reorders ranking, caps displayed score + verdict).
# Key on page count + indexability ONLY, NOT data sourcing (official vs scraping is a feasibility concern):
# Rule A (account-gated SaaS = un-indexable) + Rule B (thin/few pages @Stage12) always apply.
# ENABLE_SEO_HANDSEED_CAP=false     # Rule C (brittle string heuristic on content_generation_model) — off by default
# SEO_CAP_REQUIRE_SAAS_FOR_GATING=true  # Rule A: require project_type==saas (not just restricted data)
# SEO_CAP_GATED_SAAS_CEILING=0.5    # Rule A ceiling
# SEO_CAP_THIN_PAGES_THRESHOLD=50   # Rule B lower band (post-Stage-12 only)
# SEO_CAP_THIN_PAGES_CEILING=0.4
# SEO_CAP_HIGH_SCORE_MIN_PAGES=300  # min pages to keep a 0.8+ score
# SEO_CAP_MODERATE_PAGES_CEILING=0.7
# SEO_CAP_HANDSEED_CEILING=0.6      # Rule C ceiling (only when ENABLE_SEO_HANDSEED_CAP=true)

# Feasibility grounding (default OFF — turn on only after a calibration / rank-stability run):
# ENABLE_FEASIBILITY_CRITIC=false   # Merged novelty+feasibility critic: scores build + data feasibility, classifies data_access_model (public/freemium/paywalled/unofficial/restricted), drops only no-route ideas. Surfaces data feasibility in the report.
# ENABLE_VERDICT_DATA_CAPS=false    # Downgrade-only verdict caps: technical_feasibility capped by the critic's build estimate; market_fit capped by the addressed pain's opportunity. Never mutates stored scores (ranking unchanged); only the Go/No-Go verdict gets more conservative.
# Ideation convergent tiers — cheaper models/effort for the non-creative steps (see settings.py)
IDEATION_JUDGE_LLM=gpt-5.4-mini     # JUDGE tier: novelty critic + concept evaluator/filter (scoring, not creative — reasoning mini is enough)
IDEATION_JUDGE_REASONING_EFFORT=low # Judge tier depth; bump to medium if obviousness discrimination degrades
IDEATION_REFINE_LLM=gpt-5.2         # REFINE tier: final + re-injected idea refiner (writes user-facing copy — keep full model; gpt-5.4-mini to save)
IDEATION_REFINE_REASONING_EFFORT=medium # Refine tier depth (structured enhancement, not divergent ideation)
IDEATION_MENTOR_LLM=gpt-5.4-mini    # Creative MENTOR in the idea-improvement loop (post-calibration); guides weak ideas to sharper/buildable/on-pain. Use a DIFFERENT family than IDEATION_REFINE_LLM so it doesn't self-judge.
IDEATION_MENTOR_REASONING_EFFORT=medium # Mentor judges 3 soft dims + proposes a creative direction
# ENABLE_NOVELTY_ENHANCE=false  # Targeted novelty pass: a validated-but-obvious cell winner gets ONE refiner revision (more differentiated mechanism, same pain+data), kept only if it strictly improves (accept-guarded → never worsens the set). Cost-gated. Dark by default; A/B-validated (0 worse / 0 drifted across 3 niches).
# NOVELTY_ENHANCE_LLM=openrouter/deepseek/deepseek-v4-pro:nitro  # Refiner for the (flag-gated, ENABLE_NOVELTY_ENHANCE) novelty pass — SEPARATE from IDEATION_REFINE_LLM so the ideator is unaffected. Called reasoning-off + creative=True. A/B winner across 3 niches (4/4 Opus-genuine vs glm-4.7 ~78%, highest novelty); slower. Use a family distinct from the calibration critic (qwen) to avoid self-judging.
# Realism calibration critic — independent post-refinement re-score of the 5 idea criteria (market_fit/technical_feasibility/novelty/seo/obviousness); REPLACES the generator's optimistic self-scores (raw kept in *_score_raw). A/B-validated vs a gpt-5.2 reference (scripts/score_calibration_ab.py).
ENABLE_SCORE_CALIBRATION=true       # Master switch; ON by default. false => use the generator's raw self-scores.
SCORE_CALIBRATION_LLM=openrouter/qwen/qwen3.7-max # Calibration judge (independent of brainstorm pool). qwen3.7-max won the A/B (tightest to reference, no market_fit overcorrection) — cheaper than gpt-5.4-mini/deepseek; glm-5.2 equal quality but ~2.5x slower.
# Angle-aware deep research (Stage 2) is PERMANENT (ENABLE_ANGLE_CONDITIONED_RESEARCH removed 2026-07-07, A/B-validated 2026-06-30): always front-loads the selected idea's winning-angle kill-question into the Stage-2 SEO + competitor crew prompts so they investigate what validates/kills THAT angle (and stress-test it honestly, never inflate).
ENABLE_SEO_KILL_QUESTION=true       # Deterministic SEO-thesis stress-test for distribution_seo ideas in Stage 6 (page ceiling + KD distribution + forum-soft-SERP bonus + penalty-risk flag). Catches the pSEO mirage. Only fires for distribution_seo.
# Go/No-Go verdict — both ON (A/B-validated 2026-06-30):
ENABLE_LLM_VERDICT_EXPLANATION=true        # explain the DECIDED verdict with an LLM (told the verdict + score bands + angle + downgrade), validated to match the verdict's stance + use NO decimals, with a deterministic band template as fallback
# ENABLE_ANGLE_AWARE_VERDICT removed 2026-07-01 — the lift-only angle-aware verdict is now permanent (always on when the idea has a winning angle)
# OpenRouter model-layer failover chains (JSON): primary -> fallbacks, sent as OpenRouter's `models` array (one request, auto-failover on 429/outage,
# billed only for the successful run). REQUIRED for single-provider models (inception/mercury-2 is Inception-only — a 15s upstream 429 window killed
# the quote stance gate for a whole run on 2026-07-02). gpt-4o-mini chosen over gemini-2.5-flash-lite (live structured-output flakiness) + decorrelated provider.
LLM_FALLBACK_MODELS={"inception/mercury-2": ["openai/gpt-4o-mini"]}
# Post-selection deep-research improvements. See docs/DEEP_RESEARCH_IMPROVEMENT_PLAN.md.
# Two ON (A/B-validated 2026-06-30 over cached checkpoints):
ENABLE_SEO_KILL_QUESTION_FLOOR=true         # Ground an over-OPTIMISTIC distribution_seo verdict in the SEO kill-question: when the page universe isn't winnable (winnable SHARE low / KD high), cap Go->Conditional + floor risk (downgrade-only). Keyed on the KD/winnability axis the SEO composite excludes (no double-count vs the thin-page Rule-B). KD-coverage-gated: abstains (fail-soft) when KD covers too little of the page universe to trust — the A/B fix that removed 14/14 sparse-data false-positives.
ENABLE_MULTISOURCE_EVIDENCE_HEADLINE=true   # Rank the report's evidence appendix across all sources (Reddit + HN/YouTube + Twitter) by normalized engagement with a per-source cap (<=60% of the 10 slots), so a small high-engagement platform can't sweep the headline — vs the Reddit-only-by-raw-score default.
ENABLE_AUDIENCE_CONDITIONED_DEEP_RESEARCH=true  # Forward the Stage-1 resolved audience (tools_currently_used / frustrations) into the competitor + SEO-seed prompts so deep research judges against the real buyer. On by default (A/B-validated 2026-06-30: 4/4 distinct-audience checkpoints judged ON_BETTER after the directive reword that keeps audience tools from displacing direct competitors). Distinct from the Phase-1-only ENABLE_AUDIENCE_AWARE_RESEARCH.
ENABLE_SCOPED_MARKET_SIZING=true            # Size the SERVICEABLE slice the idea addresses, not the whole niche: narrow the pain corpus to pain_points_addressed, keep keyword volume only as a labeled top-down cross-check, emit a qualitative scope note (NO fabricated bottom-up SAM). On by default (A/B-validated 2026-06-30: corrected an over-optimistic Strong->Moderate verdict on a strong-contrast niche, no-op on a weak-contrast one; thin data — 1 strong checkpoint cached).
SCORE_CALIBRATION_REASONING_EFFORT=none # Critic depth. none: reasoning-ON intermittently empties the tool-call via :nitro routing (calibration skipped); adds no measurable quality (none≈low≈med).
# Angle-aware idea evaluation is production-on; false is emergency rollback only. Assigns each idea a winning_angle (distribution_seo/novel_differentiation/vertical_workflow) + rationales, then ranks each idea by its OWN angle's weights.
ENABLE_DIRECTION_AWARE_EVAL=true
COMMERCIAL_RESERVE_QUALITY_FLOOR=0.55 # One active public-corpus reserve must clear this calibrated mean quality.
SERP_PROBE_DISTRIBUTION_CANDIDATE_CAP=2 # Hard cap in addition to the single reserve; max 4.
IDEA_ANGLE_LLM=openrouter/qwen/qwen3.7-max # In-cell angle classifier (independent of the brainstorm pool)
IDEA_ANGLE_REASONING_EFFORT=medium  # Classifier depth — picks the angle + writes angle_rationale/novelty_rationale
NOVELTY_ENHANCE_SKIP_SEO_FLOOR=0.5  # Novelty-enhance skips distribution_seo ideas with SEO >= this floor (data-rep edge, not mechanism — low novelty is expected)
KEYWORD_VALIDATION_LLM=gpt-5-nano   # Keyword relevance validation (gpt-5-nano: $0.05/M, binary decisions)
PAIN_POINT_VALIDATION_LLM=gpt-4.1-mini  # Pain point analysis/validation in Stage 6 (non-reasoning model for max_tokens support)
PAIN_SOLUTION_MAPPING_LLM=gpt-4o-mini  # Pain-to-solution mapping in Stage 10 report (gpt-4o-mini: cost-effective)
LANDING_PAGE_LLM=gpt-5.2            # Landing page generation (gpt-5.2: $1.75/M, high-quality creative output)
LANDING_PAGE_CREATIVE_REASONING_EFFORT=high  # Creative agents: Strategist, Creative Director, Visual Designer, Brand Designer, Copywriter
LANDING_PAGE_EXECUTION_REASONING_EFFORT=medium # Code agents: HTML Developer, Animation Enhancer
LANDING_PAGE_VALIDATION_REASONING_EFFORT=low # Validation agents: QA Reviewer
LANDING_PAGE_EXECUTION_LLM=gpt-5.3-codex # Execution agents (HTML, Animation, QA): Codex for reliable code generation, ~30% fewer tokens
# Available models for LANDING_PAGE_EXECUTION_LLM:
#   OpenAI:   gpt-5.3-codex (default; gpt-5.1-codex-max is RETIRED), gpt-5.2, gpt-4o
#   Kimi:     kimi-k2.5 ($0.60/M input, 256K context, free 1.5M tokens/day)
# When using a Kimi model, set MOONSHOT_API_KEY below

# Moonshot AI (Kimi K2.5) - Optional alternative for landing page HTML generation
# Get key at: https://platform.moonshot.ai
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# KIMI_THINKING=false  # true = thinking mode (deeper reasoning, temp=1.0), false = instant mode (faster, temp=0.6)

# OpenRouter - Optional alternative provider (per-tier).
# Point ANY *_LLM tier above at an 'openrouter/<vendor>/<model>' id to route it
# through OpenRouter (e.g. CONTENT_ANALYSIS_LLM=openrouter/google/gemma-2-27b-it).
# OPENAI_API_KEY stays REQUIRED — embeddings + the Codex landing-page tier have no
# OpenRouter path, and any non-overridden tier still uses OpenAI.
# Get key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default
# OPENROUTER_SITE_URL=                                # optional HTTP-Referer (dashboard attribution)
# OPENROUTER_APP_NAME=                                # optional X-Title (dashboard attribution)
#
# Tier safety when overriding with openrouter/* models:
#   SAFE/CONDITIONAL : THREAD_VALIDATION_LLM, STANCE_VALIDATION_LLM, KEYWORD_VALIDATION_LLM,
#                      COMPETITOR_EXTRACTION_LLM, PAIN_SOLUTION_MAPPING_LLM — native structured
#                      output; needs a TOOL-CAPABLE OpenRouter model (weak models like gemma may
#                      fail structured output).
#   RISKY            : OPENAI_MODEL_NAME (shared by ~23 agents), PAIN_POINT_VALIDATION_LLM —
#                      CrewAI prompt-based JSON; weak models may lose data / retry / hard-fail.
#   REASONING TIERS  : BRAINSTORM_LLM/BRAINSTORM_LLMS/IDEATION_* — use a reasoning-capable OpenRouter
#                      model; the tier's *_REASONING_EFFORT IS forwarded (none/minimal/unset => reasoning OFF).
#   UNSAFE (avoid)   : CONTENT_ANALYSIS_LLM (needs ~150K context), FUNCTION_CALLING_LLM (tool calls).
#   BLOCKED (raises) : LANDING_PAGE_LLM, LANDING_PAGE_EXECUTION_LLM (Codex/Responses-API only).
#   Backend: SUGGEST_LLM_MODEL / CATEGORIZE_LLM_MODEL / OPENAI_FAQ_MODEL also accept openrouter/* ids.
#   Embeddings always stay on OpenAI (OpenRouter has no embeddings endpoint).

# ChromaDB API Key (required for CrewAI knowledge sources / RAG)
# ChromaDB uses this as the default environment variable name for OpenAI embeddings
# Should be set to the same value as your OPENAI_API_KEY
CHROMA_OPENAI_API_KEY=your_openai_api_key_here

# CrewAI+ (Enterprise) - Optional
CREWAI_API_KEY=your_crewai_api_key_here

# Serper.dev API (Google Search)
SERPER_API_KEY=your_serper_api_key_here

# Reddit API Credentials (PRAW)
ENABLE_REDDIT=true  # Set to false to skip Reddit collection entirely
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=NicheIQ/0.1.0

# Twitter Scraping (if using authenticated scraper)
ENABLE_TWITTER=false  # Set to true to enable Twitter collection
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email

# DataForSEO API
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# Application Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
MAX_RETRIES=3
TIMEOUT_SECONDS=60  # API timeout in seconds (60s recommended for DataForSEO large batches)

# Search Configuration
NUM_SEARCH_QUERIES=40  # Number of search queries to generate for discovering pain points
# ENABLE_AUDIENCE_AWARE_RESEARCH=false  # Part C: soft, additive audience bias on queries + pain mining when Stage-1 detects a focusable audience (broad coverage preserved). Default off.
# AUDIENCE_QUERY_ALLOTMENT=6  # Extra Reddit query slots reserved for audience queries when the above is on (added on top of NUM_SEARCH_QUERIES)
MIN_REDDIT_UPVOTES=5
MIN_REDDIT_COMMENTS=3
# REDDIT_COMMENT_LIMIT=32  # Uncomment and set to: None=all comments (leave commented), 32=most comments, 0=top-level only
MIN_COMMENT_LENGTH=50  # Minimum character length for Reddit comments (filters out short/low-value comments like "+1", "same", etc.)
MAX_REDDIT_CONTENT_TOKENS=400000  # Maximum tokens for Reddit content in Stage 6 (filters by engagement/recency to fit context)
MIN_TWITTER_LIKES=5
MIN_TWITTER_REPLIES=3

# Reddit Freshness Search (date-filtered Serper queries for recent posts)
REDDIT_FRESHNESS_SEARCH_ENABLED=true  # Enable date-filtered Serper search to find fresh Reddit posts
REDDIT_FRESHNESS_TBS=qdr:y  # Google time filter: qdr:d (day), qdr:w (week), qdr:m (month), qdr:y (year)
REDDIT_FRESHNESS_QUERY_FRACTION=0.3  # Fraction of search queries to run with date filter (0.0-1.0)

# PRAW Native Reddit Search (searches subreddits directly for very recent posts)
REDDIT_NATIVE_SEARCH_ENABLED=true  # Enable PRAW subreddit.search() for posts not yet indexed by Google
REDDIT_NATIVE_SEARCH_TIME_FILTER=month  # PRAW time filter: hour, day, week, month, year, all
REDDIT_NATIVE_SEARCH_QUERY_FRACTION=0.25  # Fraction of queries to search natively (0.0-1.0)
REDDIT_NATIVE_SEARCH_MAX_RESULTS=10  # Max results per subreddit×query combination

# Token Budget Freshness Reserve (ensures fresh posts survive token budget filtering)
TOKEN_BUDGET_FRESHNESS_RESERVE=0.25  # Fraction of token budget reserved for fresh posts (0.0-1.0, 0=disabled)
TOKEN_BUDGET_FRESHNESS_DAYS=180  # Posts newer than this many days are considered "fresh"

# Keyword Research Configuration
KEYWORD_MIN_SEARCH_VOLUME=50
KEYWORD_MAX_COMPETITION=0.7
KEYWORD_RELEVANCE_THRESHOLD=0.5  # Minimum relevance score for keyword validation in Stage 9.5c (never lowered)
TARGET_LOCATION=2840  # United States (DataForSEO location code)
TARGET_LANGUAGE=en

# Solution Validation (Stage 8 Pricing + Stage 8.5 Keyword Validation)
TOP_SOLUTIONS_FOR_VALIDATION=3  # Number of top solutions to validate (1-7; 3=balanced, 5=thorough)
KEYWORD_PROBE_CANDIDATE_CAP=4  # Hard total Stage-6 paid keyword candidate cap (1-6); selected and reserve first.

# Stage 8.5: Adaptive Keyword Validation (Pivot Strategies)
KEYWORD_MIN_VOLUME_THRESHOLD=10  # Minimum volume threshold for relevance checking (lower bar than KEYWORD_MIN_SEARCH_VOLUME)
KEYWORD_PIVOT_MAX_ATTEMPTS=4  # Maximum pivot attempts (1-4; original strategy + up to 3 pivots)
KEYWORD_QUICK_EXPANSION_SIZE=50  # Target number of keywords for quick expansion during relevance testing

# Stage 9.5c: Keyword Enrichment Quality Gates
KEYWORD_ENRICHMENT_MIN_COVERAGE=0.30  # Minimum coverage rate (validated/total). Warn if <30% keywords pass validation
KEYWORD_ENRICHMENT_TARGET_COVERAGE=0.60  # Target coverage rate. Celebrate if ≥60% keywords pass validation
KEYWORD_TIERING_MIN_COVERAGE=0.30  # Minimum tiering coverage (tiered/enriched). Warn if <30% keywords are tiered

# Go/No-Go Verdict Thresholds (defaults shown — uncomment to override)
# VERDICT_GO_AVG_SCORE=0.75               # Minimum average score for Go verdict
# VERDICT_GO_MIN_INDIVIDUAL_SCORE=0.60     # Minimum individual score (market_fit, tech_feasibility) for Go
# VERDICT_CONDITIONAL_AVG_SCORE=0.55       # Minimum average score for Conditional verdict
# VERDICT_CONDITIONAL_MIN_INDIVIDUAL_SCORE=0.50  # Minimum individual score for Conditional verdict

# Token Monitoring & Cost Control (Soft Caps)
TOKEN_MONITORING_ENABLED=true  # Enable token counting and cost logging
TOKEN_WARNING_THRESHOLD=200000  # Log warning when content exceeds 200K tokens
TOKEN_SOFT_CAP_ENABLED=false  # Enable soft cap enforcement (logs critical warning but doesn't fail)
TOKEN_SOFT_CAP=400000  # Soft cap token limit (if enabled, logs critical warning when exceeded)
COST_LOGGING_ENABLED=true  # Log estimated API costs for token usage

# Performance Optimization - Parallel Validation
VALIDATION_PARALLEL_ENABLED=true  # Enable parallel batch processing for validation tasks (keyword and thread validation)
KEYWORD_VALIDATION_MAX_WORKERS=3  # Parallel workers for keyword validation (Stage 9.5c). Recommended: 3-5 for balance of speed and API limits
KEYWORD_VALIDATION_BATCH_SIZE=50  # Keywords per API call within each parallel worker (Stage 9.5c). Recommended: 50-150
THREAD_VALIDATION_MAX_WORKERS=4  # Parallel workers for thread validation (Stage 5). Recommended: 3-5 for balanced throughput

# Output Configuration
OUTPUT_DIR=./output
REPORTS_DIR=./output/reports

# Google Analytics GA4 (leave empty to disable analytics)
PUBLIC_GA_MEASUREMENT_ID=

# Origin used for absolute canonical URLs and JSON-LD @id values.
# Override locally for staging/preview deployments. Defaults to https://nicheiq.dev when unset.
PUBLIC_SITE_ORIGIN=https://nicheiq.dev

# =============================================================================
# WEB APP CONFIGURATION (for Node.js backend + Python Redis-list workers)
# =============================================================================

# PostgreSQL Database (for job tracking)
DATABASE_URL=postgresql://nicheiq:nicheiq@localhost:5435/nicheiq

# Redis (Job Queue + Pub/Sub for progress updates)
REDIS_URL=redis://localhost:6380

# Node.js API Server
PORT=3001
NODE_ENV=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL for links in emails
BASE_URL=http://localhost:3000

# Email (SMTP) - for sending completion notifications
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# Web job output directory
NICHEIQ_OUTPUT_DIR=./output/jobs

# Job data retention (seconds, default 7 days)
JOB_TTL_SECONDS=604800

# Niche Suggestion Settings (Feeling Lucky feature)
# gpt-5-nano runs at forced 'minimal' reasoning effort via chatComplete().
SUGGEST_LLM_MODEL=gpt-5-nano
SUGGEST_RATE_HOURLY=40
SUGGEST_RATE_DAILY=50

# Catalog categorization model (admin-triggered). gpt-5-nano @ minimal effort.
CATEGORIZE_LLM_MODEL=gpt-5-nano

# Guided analyst chat. Tool rounds use Chat Completions with reasoning disabled.
CHAT_LLM_MODEL=gpt-5.6-luna

# Founder-fit JSON analysis is independently configurable from analyst chat.
FOUNDER_FIT_LLM_MODEL=gpt-5-mini

# Rate limit: solution validation (max requests per hour, default 20)
RATE_LIMIT_SOLUTION_VALIDATION=20

# Catalog FAQ Generation (Phase B — admin-triggered LLM Q&A from page data;
# see plans/pure-giggling-beacon.md). Used by /api/admin/catalog/faq/generate
# to draft FAQs for sub-niche, idea, and pain-point detail pages.
#
# Same model is used across all three page types in v1. Per-deploy overridable
# without a code release. Code-level fallback when unset: 'gpt-4.1-mini'.
# Production deploys should set this explicitly.
#
# Recommended values (cheapest → most capable):
#   - gpt-4o-mini   (~$0.0008/regenerate — older, fast, decent quality)
#   - gpt-4.1-mini  (default fallback — similar cost, better instruction-following)
#   - gpt-4o        (~$0.020/regenerate — best adherence to nuanced rules like
#                    'never use solution_name codename in idea-page questions')
OPENAI_FAQ_MODEL=gpt-4.1-mini

# Per-admin per-hour rate limits for the FAQ generate/save flow. Generate is
# the expensive one (LLM call). Save is cheap but kept gated to discourage
# accidental loops. 429 surfaces in the admin UI as a friendly toast.
FAQ_GENERATE_RATE_HOURLY=30
FAQ_SAVE_RATE_HOURLY=60

# =============================================================================
# AUTHENTICATION (Auth.js / OAuth)
# =============================================================================

# Auth.js secret key (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret-here

# Public experiment-view token signing (independent; required in production)
EXPERIMENT_SIGNING_SECRET=your-experiment-signing-secret

# Internal service secret for frontend-backend and worker-backend communication
# Required in production; generate with: openssl rand -base64 32
INTERNAL_SERVICE_SECRET=your-internal-service-secret

# Phase 4.5 launch gate for the public catalog (/ideas/*).
# Set to 'true' (default) to ship every category/idea/pain-point page with
# `<meta name="robots" content="noindex,follow">` and omit them from the
# sitemap. Flip to 'false' once Phase 4.5 baseline copy curation is complete.
# Avoids Google's thin-content penalty during the rollout window.
SEO_LAUNCH_GATE=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub App for explicit decision-handoff issue creation. This is separate
# from the GitHub OAuth login settings above. Keep disabled until the App has
# Metadata: read and Issues: write repository permissions.
GITHUB_APP_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Base64-encoded PEM private key; never expose this to the frontend.
# Generate one line: base64 < private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/integrations/github/callback

# Backend URL for credential validation (frontend -> backend)
BACKEND_URL=http://localhost:3001

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================

# Stripe API Keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Secret (https://dashboard.stripe.com/webhooks)
# Create endpoint for: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# WEBSHARE PROXY (for YouTube transcript fetching)
# =============================================================================

# Webshare API key. When set, YouTube transcripts route through direct-mode
# proxies dynamically fetched from /api/v2/proxy/list. Bypasses YouTube
# datacenter IP blocks. Direct-mode plans only (free / starter).
# Get at: https://proxy2.webshare.io/userapi/keys
WEBSHARE_API_KEY=

# Optional: comma-separated ISO country codes to restrict the proxy pool
# WEBSHARE_PROXY_COUNTRY_CODES=US,GB
