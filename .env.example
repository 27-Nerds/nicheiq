# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-5-mini        # Default agent reasoning (gpt-5-mini: $0.25/M, 400K context)
FUNCTION_CALLING_LLM=gpt-5-nano     # Tool/function calls (gpt-5-nano: $0.05/M, fast & cheap)
CONTENT_ANALYSIS_LLM=gpt-4.1-mini   # Content analysis (gpt-4.1-mini: $0.40/M, 1M context for large Reddit content)
THREAD_VALIDATION_LLM=gpt-5-nano    # Thread relevance validation (gpt-5-nano: $0.05/M, binary decisions)
BRAINSTORM_LLM=gpt-5.2              # Solution brainstorming — CREATIVE tier (divergent gen + ideator)
BRAINSTORM_REASONING_EFFORT=medium  # Creative tier depth (none/minimal/low/medium/high/xhigh) - the only working creativity lever on reasoning models
# Ideation convergent tiers — cheaper models/effort for the non-creative steps (see settings.py)
IDEATION_JUDGE_LLM=gpt-5.4-mini     # JUDGE tier: novelty critic + concept evaluator/filter (scoring, not creative — reasoning mini is enough)
IDEATION_JUDGE_REASONING_EFFORT=low # Judge tier depth; bump to medium if obviousness discrimination degrades
IDEATION_REFINE_LLM=gpt-5.2         # REFINE tier: final + re-injected idea refiner (writes user-facing copy — keep full model; gpt-5.4-mini to save)
IDEATION_REFINE_REASONING_EFFORT=medium # Refine tier depth (structured enhancement, not divergent ideation)
KEYWORD_VALIDATION_LLM=gpt-5-nano   # Keyword relevance validation (gpt-5-nano: $0.05/M, binary decisions)
PAIN_POINT_VALIDATION_LLM=gpt-4.1-mini  # Pain point analysis/validation in Stage 6 (non-reasoning model for max_tokens support)
PAIN_SOLUTION_MAPPING_LLM=gpt-4o-mini  # Pain-to-solution mapping in Stage 10 report (gpt-4o-mini: cost-effective)
LANDING_PAGE_LLM=gpt-5.2            # Landing page generation (gpt-5.2: $1.75/M, high-quality creative output)
LANDING_PAGE_CREATIVE_REASONING_EFFORT=high  # Creative agents: Strategist, Creative Director, Visual Designer, Brand Designer, Copywriter
LANDING_PAGE_EXECUTION_REASONING_EFFORT=medium # Code agents: HTML Developer, Animation Enhancer
LANDING_PAGE_VALIDATION_REASONING_EFFORT=low # Validation agents: QA Reviewer
LANDING_PAGE_EXECUTION_LLM=gpt-5.1-codex-max # Execution agents (HTML, Animation, QA): Codex for reliable code generation, ~30% fewer tokens
# Available models for LANDING_PAGE_EXECUTION_LLM:
#   OpenAI:   gpt-5.1-codex-max (default), gpt-5.2, gpt-4o
#   Kimi:     kimi-k2.5 ($0.60/M input, 256K context, free 1.5M tokens/day)
# When using a Kimi model, set MOONSHOT_API_KEY below

# Moonshot AI (Kimi K2.5) - Optional alternative for landing page HTML generation
# Get key at: https://platform.moonshot.ai
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# KIMI_THINKING=false  # true = thinking mode (deeper reasoning, temp=1.0), false = instant mode (faster, temp=0.6)

# OpenRouter - Optional alternative provider (per-tier).
# Point ANY *_LLM tier above at an 'openrouter/<vendor>/<model>' id to route it
# through OpenRouter (e.g. CONTENT_ANALYSIS_LLM=openrouter/google/gemma-2-27b-it).
# OPENAI_API_KEY stays REQUIRED — embeddings + the Codex landing-page tier have no
# OpenRouter path, and any non-overridden tier still uses OpenAI.
# Get key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default
# OPENROUTER_SITE_URL=                                # optional HTTP-Referer (dashboard attribution)
# OPENROUTER_APP_NAME=                                # optional X-Title (dashboard attribution)
#
# Tier safety when overriding with openrouter/* models:
#   SAFE/CONDITIONAL : THREAD_VALIDATION_LLM, KEYWORD_VALIDATION_LLM, COMPETITOR_EXTRACTION_LLM,
#                      PAIN_SOLUTION_MAPPING_LLM — native structured output; needs a TOOL-CAPABLE
#                      OpenRouter model (weak models like gemma may fail structured output).
#   RISKY            : OPENAI_MODEL_NAME (shared by ~23 agents), PAIN_POINT_VALIDATION_LLM —
#                      CrewAI prompt-based JSON; weak models may lose data / retry / hard-fail.
#   UNSAFE (avoid)   : CONTENT_ANALYSIS_LLM (needs ~150K context), FUNCTION_CALLING_LLM (tool calls),
#                      BRAINSTORM_LLM/IDEATION_* (reasoning_effort is ignored on OpenRouter).
#   BLOCKED (raises) : LANDING_PAGE_LLM, LANDING_PAGE_EXECUTION_LLM (Codex/Responses-API only).
#   Backend: SUGGEST_LLM_MODEL / CATEGORIZE_LLM_MODEL / OPENAI_FAQ_MODEL also accept openrouter/* ids.
#   Embeddings always stay on OpenAI (OpenRouter has no embeddings endpoint).

# ChromaDB API Key (required for CrewAI knowledge sources / RAG)
# ChromaDB uses this as the default environment variable name for OpenAI embeddings
# Should be set to the same value as your OPENAI_API_KEY
CHROMA_OPENAI_API_KEY=your_openai_api_key_here

# CrewAI+ (Enterprise) - Optional
CREWAI_API_KEY=your_crewai_api_key_here

# Serper.dev API (Google Search)
SERPER_API_KEY=your_serper_api_key_here

# Reddit API Credentials (PRAW)
ENABLE_REDDIT=true  # Set to false to skip Reddit collection entirely
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=NicheIQ/0.1.0

# Twitter Scraping (if using authenticated scraper)
ENABLE_TWITTER=false  # Set to true to enable Twitter collection
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email

# DataForSEO API
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# Application Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
MAX_RETRIES=3
TIMEOUT_SECONDS=60  # API timeout in seconds (60s recommended for DataForSEO large batches)

# Search Configuration
NUM_SEARCH_QUERIES=40  # Number of search queries to generate for discovering pain points
MAX_SEARCH_RESULTS=20
MIN_REDDIT_UPVOTES=5
MIN_REDDIT_COMMENTS=3
# REDDIT_COMMENT_LIMIT=32  # Uncomment and set to: None=all comments (leave commented), 32=most comments, 0=top-level only
MIN_COMMENT_LENGTH=50  # Minimum character length for Reddit comments (filters out short/low-value comments like "+1", "same", etc.)
MAX_REDDIT_CONTENT_TOKENS=400000  # Maximum tokens for Reddit content in Stage 6 (filters by engagement/recency to fit context)
MIN_TWITTER_LIKES=5
MIN_TWITTER_REPLIES=3

# Reddit Freshness Search (date-filtered Serper queries for recent posts)
REDDIT_FRESHNESS_SEARCH_ENABLED=true  # Enable date-filtered Serper search to find fresh Reddit posts
REDDIT_FRESHNESS_TBS=qdr:y  # Google time filter: qdr:d (day), qdr:w (week), qdr:m (month), qdr:y (year)
REDDIT_FRESHNESS_QUERY_FRACTION=0.3  # Fraction of search queries to run with date filter (0.0-1.0)

# PRAW Native Reddit Search (searches subreddits directly for very recent posts)
REDDIT_NATIVE_SEARCH_ENABLED=true  # Enable PRAW subreddit.search() for posts not yet indexed by Google
REDDIT_NATIVE_SEARCH_TIME_FILTER=month  # PRAW time filter: hour, day, week, month, year, all
REDDIT_NATIVE_SEARCH_QUERY_FRACTION=0.25  # Fraction of queries to search natively (0.0-1.0)
REDDIT_NATIVE_SEARCH_MAX_RESULTS=10  # Max results per subreddit×query combination

# Token Budget Freshness Reserve (ensures fresh posts survive token budget filtering)
TOKEN_BUDGET_FRESHNESS_RESERVE=0.25  # Fraction of token budget reserved for fresh posts (0.0-1.0, 0=disabled)
TOKEN_BUDGET_FRESHNESS_DAYS=180  # Posts newer than this many days are considered "fresh"

# Keyword Research Configuration
KEYWORD_MIN_SEARCH_VOLUME=50
KEYWORD_MAX_COMPETITION=0.7
KEYWORD_RELEVANCE_THRESHOLD=0.5  # Minimum relevance score for keyword validation in Stage 9.5c (never lowered)
TARGET_LOCATION=2840  # United States (DataForSEO location code)
TARGET_LANGUAGE=en

# Solution Validation (Stage 8 Pricing + Stage 8.5 Keyword Validation)
TOP_SOLUTIONS_FOR_VALIDATION=3  # Number of top solutions to validate (1=fastest, 3=balanced, 5=thorough)

# Stage 8.5: Adaptive Keyword Validation (Pivot Strategies)
KEYWORD_MIN_VOLUME_THRESHOLD=10  # Minimum volume threshold for relevance checking (lower bar than KEYWORD_MIN_SEARCH_VOLUME)
KEYWORD_PIVOT_MAX_ATTEMPTS=4  # Maximum pivot attempts (original strategy + 3 pivots)
KEYWORD_QUICK_EXPANSION_SIZE=50  # Target number of keywords for quick expansion during relevance testing
KEYWORD_RESEARCH_LLM=gpt-5-nano   # Keyword research crew (gpt-5-nano: $0.05/M, structured analysis)
KEYWORD_VALIDATION_TOP_PAIN_POINTS=5  # Number of top pain points to include in keyword validation context
KEYWORD_VALIDATION_TOP_COMPETITORS=10  # Number of top competitors to include in keyword validation context
KEYWORD_VALIDATION_TEMPERATURE=0.7  # LLM temperature for keyword research crew (0.7 recommended for creative tasks with constraints)

# Stage 9.5c: Keyword Enrichment Quality Gates
KEYWORD_ENRICHMENT_MIN_COVERAGE=0.30  # Minimum coverage rate (validated/total). Warn if <30% keywords pass validation
KEYWORD_ENRICHMENT_TARGET_COVERAGE=0.60  # Target coverage rate. Celebrate if ≥60% keywords pass validation
KEYWORD_TIERING_MIN_COVERAGE=0.30  # Minimum tiering coverage (tiered/enriched). Warn if <30% keywords are tiered

# Go/No-Go Verdict Thresholds (defaults shown — uncomment to override)
# VERDICT_GO_AVG_SCORE=0.75               # Minimum average score for Go verdict
# VERDICT_GO_MIN_INDIVIDUAL_SCORE=0.60     # Minimum individual score (market_fit, tech_feasibility) for Go
# VERDICT_CONDITIONAL_AVG_SCORE=0.55       # Minimum average score for Conditional verdict
# VERDICT_CONDITIONAL_MIN_INDIVIDUAL_SCORE=0.50  # Minimum individual score for Conditional verdict

# Token Monitoring & Cost Control (Soft Caps)
TOKEN_MONITORING_ENABLED=true  # Enable token counting and cost logging
TOKEN_WARNING_THRESHOLD=200000  # Log warning when content exceeds 200K tokens
TOKEN_SOFT_CAP_ENABLED=false  # Enable soft cap enforcement (logs critical warning but doesn't fail)
TOKEN_SOFT_CAP=400000  # Soft cap token limit (if enabled, logs critical warning when exceeded)
COST_LOGGING_ENABLED=true  # Log estimated API costs for token usage

# Cost Budget Tracking
COST_BUDGET_ENABLED=false  # Enable cost budget tracking with per-stage breakdown
COST_BUDGET_LIMIT=5.00  # Maximum API cost budget per run in USD (soft limit, logs warning when exceeded)

# Performance Optimization - Parallel Validation
VALIDATION_PARALLEL_ENABLED=true  # Enable parallel batch processing for validation tasks (keyword and thread validation)
KEYWORD_VALIDATION_MAX_WORKERS=3  # Parallel workers for keyword validation (Stage 9.5c). Recommended: 3-5 for balance of speed and API limits
KEYWORD_VALIDATION_BATCH_SIZE=50  # Keywords per API call within each parallel worker (Stage 9.5c). Recommended: 50-150
THREAD_VALIDATION_MAX_WORKERS=4  # Parallel workers for thread validation (Stage 5). Recommended: 3-5 for balanced throughput

# Output Configuration
OUTPUT_DIR=./output
REPORTS_DIR=./output/reports

# Google Analytics GA4 (leave empty to disable analytics)
PUBLIC_GA_MEASUREMENT_ID=

# Origin used for absolute canonical URLs and JSON-LD @id values.
# Override locally for staging/preview deployments. Defaults to https://nicheiq.dev when unset.
PUBLIC_SITE_ORIGIN=https://nicheiq.dev

# =============================================================================
# WEB APP CONFIGURATION (for Node.js backend + Python RQ workers)
# =============================================================================

# PostgreSQL Database (for job tracking)
DATABASE_URL=postgresql://nicheiq:nicheiq@localhost:5432/nicheiq

# Redis (Job Queue + Pub/Sub for progress updates)
REDIS_URL=redis://localhost:6379

# Node.js API Server
PORT=3001
NODE_ENV=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL for links in emails
BASE_URL=http://localhost:3000

# Email (SMTP) - for sending completion notifications
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# Web job output directory
NICHEIQ_OUTPUT_DIR=./output/jobs

# Job data retention (seconds, default 7 days)
JOB_TTL_SECONDS=604800

# Niche Suggestion Settings (Feeling Lucky feature)
# gpt-5-nano runs at forced 'minimal' reasoning effort via chatComplete().
SUGGEST_LLM_MODEL=gpt-5-nano
SUGGEST_RATE_HOURLY=40
SUGGEST_RATE_DAILY=50

# Catalog categorization model (admin-triggered). gpt-5-nano @ minimal effort.
CATEGORIZE_LLM_MODEL=gpt-5-nano

# Rate limit: solution validation (max requests per hour, default 20)
RATE_LIMIT_SOLUTION_VALIDATION=20

# Catalog FAQ Generation (Phase B — admin-triggered LLM Q&A from page data;
# see plans/pure-giggling-beacon.md). Used by /api/admin/catalog/faq/generate
# to draft FAQs for sub-niche, idea, and pain-point detail pages.
#
# Same model is used across all three page types in v1. Per-deploy overridable
# without a code release. Code-level fallback when unset: 'gpt-4.1-mini'.
# Production deploys should set this explicitly.
#
# Recommended values (cheapest → most capable):
#   - gpt-4o-mini   (~$0.0008/regenerate — older, fast, decent quality)
#   - gpt-4.1-mini  (default fallback — similar cost, better instruction-following)
#   - gpt-4o        (~$0.020/regenerate — best adherence to nuanced rules like
#                    'never use solution_name codename in idea-page questions')
OPENAI_FAQ_MODEL=gpt-4.1-mini

# Per-admin per-hour rate limits for the FAQ generate/save flow. Generate is
# the expensive one (LLM call). Save is cheap but kept gated to discourage
# accidental loops. 429 surfaces in the admin UI as a friendly toast.
FAQ_GENERATE_RATE_HOURLY=30
FAQ_SAVE_RATE_HOURLY=60

# =============================================================================
# AUTHENTICATION (Auth.js / OAuth)
# =============================================================================

# Auth.js secret key (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret-here

# Internal service secret for frontend-backend and worker-backend communication
# Required in production; generate with: openssl rand -base64 32
INTERNAL_SERVICE_SECRET=your-internal-service-secret

# Phase 4.5 launch gate for the public catalog (/ideas/*).
# Set to 'true' (default) to ship every category/idea/pain-point page with
# `<meta name="robots" content="noindex,follow">` and omit them from the
# sitemap. Flip to 'false' once Phase 4.5 baseline copy curation is complete.
# Avoids Google's thin-content penalty during the rollout window.
SEO_LAUNCH_GATE=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Backend URL for credential validation (frontend -> backend)
BACKEND_URL=http://localhost:3001

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================

# Stripe API Keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Secret (https://dashboard.stripe.com/webhooks)
# Create endpoint for: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# WEBSHARE PROXY (for YouTube transcript fetching)
# =============================================================================

# Webshare API key. When set, YouTube transcripts route through direct-mode
# proxies dynamically fetched from /api/v2/proxy/list. Bypasses YouTube
# datacenter IP blocks. Direct-mode plans only (free / starter).
# Get at: https://proxy2.webshare.io/userapi/keys
WEBSHARE_API_KEY=

# Optional: comma-separated ISO country codes to restrict the proxy pool
# WEBSHARE_PROXY_COUNTRY_CODES=US,GB
