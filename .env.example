# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o  # or gpt-4-turbo-preview, gpt-4o-mini, gpt-3.5-turbo
FUNCTION_CALLING_LLM=gpt-4o-mini  # Model for tool/function calls (gpt-4o-mini recommended for cost efficiency)
CONTENT_ANALYSIS_LLM=gpt-4o  # Model for content analysis/categorization (gpt-4o-mini for cost savings)
THREAD_VALIDATION_LLM=gpt-4o-mini  # Model for thread relevance validation in Stage 5 (gpt-4o-mini or gpt-3.5-turbo for cost efficiency)
BRAINSTORM_LLM=gpt-4o  # Model for solution brainstorming/ideation (gpt-4o, o1-mini for deeper reasoning, or claude-3-5-sonnet)
KEYWORD_VALIDATION_LLM=gpt-4.1-nano  # Model for keyword relevance validation in Stage 9.5c (gpt-4.1-nano recommended for cost efficiency)

# ChromaDB API Key (required for CrewAI knowledge sources / RAG)
# This should be the same as your OPENAI_API_KEY for OpenAI embeddings
CHROMA_OPENAI_API_KEY=your_openai_api_key_here

# CrewAI+ (Enterprise) - Optional
CREWAI_API_KEY=your_crewai_api_key_here

# Serper.dev API (Google Search)
SERPER_API_KEY=your_serper_api_key_here

# Reddit API Credentials (PRAW)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=NicheIQ/0.1.0

# Twitter Scraping (if using authenticated scraper)
ENABLE_TWITTER=false  # Set to true to enable Twitter collection (currently broken)
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email

# DataForSEO API
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# Application Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Search Configuration
NUM_SEARCH_QUERIES=40  # Number of search queries to generate for discovering pain points
MAX_SEARCH_RESULTS=20
MIN_REDDIT_UPVOTES=5
MIN_REDDIT_COMMENTS=3
# REDDIT_COMMENT_LIMIT=32  # Uncomment and set to: None=all comments (leave commented), 32=most comments, 0=top-level only
MIN_COMMENT_LENGTH=50  # Minimum character length for Reddit comments (filters out short/low-value comments like "+1", "same", etc.)
MIN_TWITTER_LIKES=5
MIN_TWITTER_REPLIES=3

# Keyword Research Configuration
KEYWORD_MIN_SEARCH_VOLUME=50
KEYWORD_MAX_COMPETITION=0.7
KEYWORD_RELEVANCE_THRESHOLD=0.5  # Minimum relevance score for keyword validation in Stage 9.5c (never lowered)
TARGET_LOCATION=2840  # United States (DataForSEO location code)
TARGET_LANGUAGE=en

# Stage 8.8: Adaptive Keyword Validation (Pivot Strategies)
KEYWORD_MIN_VOLUME_THRESHOLD=10  # Minimum volume threshold for relevance checking (lower bar than KEYWORD_MIN_SEARCH_VOLUME)
KEYWORD_PIVOT_MAX_ATTEMPTS=4  # Maximum pivot attempts (original strategy + 3 pivots)
KEYWORD_QUICK_EXPANSION_SIZE=50  # Target number of keywords for quick expansion during relevance testing

# Token Monitoring & Cost Control (Soft Caps)
TOKEN_MONITORING_ENABLED=true  # Enable token counting and cost logging
TOKEN_WARNING_THRESHOLD=200000  # Log warning when content exceeds 200K tokens
TOKEN_SOFT_CAP_ENABLED=false  # Enable soft cap enforcement (logs critical warning but doesn't fail)
TOKEN_SOFT_CAP=400000  # Soft cap token limit (if enabled, logs critical warning when exceeded)
COST_LOGGING_ENABLED=true  # Log estimated API costs for token usage

# Output Configuration
OUTPUT_DIR=./output
REPORTS_DIR=./output/reports
