// Prisma schema for NicheIQ Web App
// Job tracking, progress, and asset management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Job lifecycle states
enum JobStatus {
  PENDING    // Job created, not yet queued
  QUEUED     // Added to Redis queue
  RUNNING    // Worker is processing
  COMPLETED  // Successfully finished
  FAILED     // Error occurred
  CANCELLED  // User cancelled
}

// Stage execution states
enum StageStatus {
  PENDING    // Not started
  RUNNING    // Currently executing
  COMPLETED  // Finished successfully
  SKIPPED    // Skipped (e.g., optional stage)
  FAILED     // Error during execution
}

// Types of generated assets
enum AssetType {
  REPORT_JSON   // Final report (JSON)
  REPORT_RAW    // Raw research state
  LANDING_PAGE  // Generated HTML landing page
}

// ============================================
// Authentication Models (Auth.js compatible)
// ============================================

// User account - core identity
model User {
  id            String    @id @default(uuid())
  email         String    @unique @db.VarChar(255)
  name          String?   @db.VarChar(255)
  image         String?   @db.Text
  emailVerified DateTime?

  // For email/password auth (nullable for OAuth-only users)
  passwordHash  String?   @db.VarChar(255)

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]

  @@index([email])
}

// OAuth accounts (one user can have multiple providers)
model Account {
  id                 String  @id @default(uuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  type               String  // "oauth" | "credentials"
  provider           String  // "google" | "github" | "credentials"
  providerAccountId  String

  // OAuth tokens
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Sessions for database-based session management
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

// Email verification tokens (for future use)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Job Management Models
// ============================================

// Main job tracking table
model Job {
  id                   String      @id @default(uuid())

  // User relationship (nullable for backward compatibility with existing jobs)
  userId               String?
  user                 User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Keep email for notifications (even if user deletes account)
  email                String      @db.VarChar(255)
  niche                String      @db.Text
  allowedProjectTypes  Json?       // Optional list of project types

  // Status tracking
  status               JobStatus   @default(PENDING)
  currentStage         Float       @default(1)
  currentStageName     String?     @db.VarChar(100)
  stagesCompleted      Int         @default(0)
  totalStages          Int         @default(14)
  progressPercent      Float       @default(0)

  // Error tracking
  errorMessage         String?     @db.Text
  errorStage           Float?

  // Timestamps
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  startedAt            DateTime?
  completedAt          DateTime?

  // Relations
  progress             JobProgress[]
  assets               JobAsset[]

  // Indexes for common queries
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Detailed progress tracking per stage
model JobProgress {
  id              Int         @id @default(autoincrement())
  jobId           String
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Stage info
  stageNumber     Float
  stageName       String      @db.VarChar(100)
  status          StageStatus @default(PENDING)

  // Timing
  startedAt       DateTime?
  completedAt     DateTime?
  durationSeconds Float?

  // Additional details
  details         Json?       // Stage-specific metadata
  errorMessage    String?     @db.Text

  @@index([jobId])
  @@unique([jobId, stageNumber])
}

// Generated assets (reports, landing pages)
model JobAsset {
  id            Int       @id @default(autoincrement())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Asset info
  assetType     AssetType
  filePath      String    @db.VarChar(500)
  fileSizeBytes Int?

  // Timestamps
  createdAt     DateTime  @default(now())

  @@index([jobId])
  @@unique([jobId, assetType])
}
