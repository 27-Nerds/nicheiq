{
  "name": "nicheiq-backend",
  "version": "1.0.0",
  "description": "NicheIQ Web API - Node.js backend for market research automation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
