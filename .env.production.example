# =============================================================================
# NicheIQ Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# For DigitalOcean deployment at nicheiq.27n.gg
# =============================================================================

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_USER=nicheiq
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=nicheiq

# =============================================================================
# AUTHENTICATION (Required)
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL

# Internal service secret for frontend-backend and worker-backend communication
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Callback URL: https://nicheiq.27n.gg/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (https://github.com/settings/developers)
# Callback URL: https://nicheiq.27n.gg/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# OPENAI API (Required for research pipeline)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key

# Model Configuration (cost-optimized defaults)
OPENAI_MODEL_NAME=gpt-4o
FUNCTION_CALLING_LLM=gpt-4o-mini
CONTENT_ANALYSIS_LLM=gpt-4o
THREAD_VALIDATION_LLM=gpt-4o-mini
BRAINSTORM_LLM=gpt-4o
KEYWORD_VALIDATION_LLM=gpt-4o-mini
KEYWORD_RESEARCH_LLM=gpt-4o-mini
LANDING_PAGE_LLM=gpt-4o

# =============================================================================
# SERPER API (Required for Google Search)
# =============================================================================
SERPER_API_KEY=your-serper-api-key

# =============================================================================
# REDDIT API (Required for social research)
# =============================================================================
ENABLE_REDDIT=true
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=NicheIQ/1.0 (Production)

# =============================================================================
# TWITTER (Optional)
# =============================================================================
ENABLE_TWITTER=false
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# =============================================================================
# DATAFORSEO API (Required for keyword research)
# =============================================================================
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@27n.gg

# =============================================================================
# APPLICATION URLS
# =============================================================================
BASE_URL=https://nicheiq.27n.gg
PUBLIC_API_URL=https://nicheiq.27n.gg
ORIGIN=https://nicheiq.27n.gg
CORS_ORIGINS=https://nicheiq.27n.gg

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO
TOKEN_MONITORING_ENABLED=true
COST_LOGGING_ENABLED=true
COST_BUDGET_ENABLED=false
COST_BUDGET_LIMIT=5.00

# =============================================================================
# JOB SETTINGS
# =============================================================================
JOB_TTL_SECONDS=604800

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================
NUM_SEARCH_QUERIES=40
MAX_SEARCH_RESULTS=20
MIN_REDDIT_UPVOTES=5
MIN_REDDIT_COMMENTS=3
MIN_COMMENT_LENGTH=50
MAX_REDDIT_CONTENT_TOKENS=400000
MIN_TWITTER_LIKES=5
MIN_TWITTER_REPLIES=3

# =============================================================================
# KEYWORD RESEARCH CONFIGURATION
# =============================================================================
KEYWORD_MIN_SEARCH_VOLUME=50
KEYWORD_MAX_COMPETITION=0.7
KEYWORD_RELEVANCE_THRESHOLD=0.5
TARGET_LOCATION=2840
TARGET_LANGUAGE=en
TOP_SOLUTIONS_FOR_VALIDATION=3
KEYWORD_MIN_VOLUME_THRESHOLD=10
KEYWORD_PIVOT_MAX_ATTEMPTS=4
KEYWORD_QUICK_EXPANSION_SIZE=50
KEYWORD_VALIDATION_TOP_PAIN_POINTS=5
KEYWORD_VALIDATION_TOP_COMPETITORS=10
KEYWORD_VALIDATION_TEMPERATURE=0.7
KEYWORD_ENRICHMENT_MIN_COVERAGE=0.30
KEYWORD_ENRICHMENT_TARGET_COVERAGE=0.60
KEYWORD_TIERING_MIN_COVERAGE=0.30

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
VALIDATION_PARALLEL_ENABLED=true
KEYWORD_VALIDATION_MAX_WORKERS=3
KEYWORD_VALIDATION_BATCH_SIZE=50
THREAD_VALIDATION_MAX_WORKERS=4
