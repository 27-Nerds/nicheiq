# =============================================================================
# NicheIQ Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# For DigitalOcean deployment at nicheiq.27n.gg
# =============================================================================

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_USER=nicheiq
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=nicheiq

# =============================================================================
# AUTHENTICATION (Required)
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL

# Internal service secret for frontend-backend and worker-backend communication
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Callback URL: https://nicheiq.27n.gg/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (https://github.com/settings/developers)
# Callback URL: https://nicheiq.27n.gg/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# OPENAI API (Required for research pipeline)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key

# Model Configuration (cost-optimized defaults)
OPENAI_MODEL_NAME=gpt-4o
FUNCTION_CALLING_LLM=gpt-4o-mini
CONTENT_ANALYSIS_LLM=gpt-4o
THREAD_VALIDATION_LLM=gpt-4o-mini
BRAINSTORM_LLM=gpt-4o
KEYWORD_VALIDATION_LLM=gpt-4o-mini
KEYWORD_RESEARCH_LLM=gpt-4o-mini
PAIN_POINT_VALIDATION_LLM=gpt-4o-mini
PAIN_SOLUTION_MAPPING_LLM=gpt-4o-mini
LANDING_PAGE_LLM=gpt-4o
BRAINSTORM_REASONING_EFFORT=
LANDING_PAGE_EXECUTION_LLM=gpt-4o
LANDING_PAGE_CREATIVE_REASONING_EFFORT=high
LANDING_PAGE_EXECUTION_REASONING_EFFORT=medium
LANDING_PAGE_VALIDATION_REASONING_EFFORT=low

# =============================================================================
# SERPER API (Required for Google Search)
# =============================================================================
SERPER_API_KEY=your-serper-api-key

# =============================================================================
# REDDIT API (Required for social research)
# =============================================================================
ENABLE_REDDIT=true
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=NicheIQ/1.0 (Production)

# =============================================================================
# TWITTER (Optional)
# =============================================================================
ENABLE_TWITTER=false
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# =============================================================================
# DATAFORSEO API (Required for keyword research)
# =============================================================================
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@27n.gg

# =============================================================================
# APPLICATION URLS
# =============================================================================
BASE_URL=https://nicheiq.27n.gg
PUBLIC_API_URL=https://nicheiq.27n.gg
ORIGIN=https://nicheiq.27n.gg
CORS_ORIGINS=https://nicheiq.27n.gg

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO
TOKEN_MONITORING_ENABLED=true
COST_LOGGING_ENABLED=true
COST_BUDGET_ENABLED=false
COST_BUDGET_LIMIT=5.00

# =============================================================================
# JOB SETTINGS
# =============================================================================
JOB_TTL_SECONDS=604800

# =============================================================================
# NICHE SUGGESTION SETTINGS (Feeling Lucky feature)
# =============================================================================
SUGGEST_LLM_MODEL=gpt-4.1-nano
SUGGEST_RATE_HOURLY=40
SUGGEST_RATE_DAILY=50

# =============================================================================
# CATALOG FAQ GENERATION (Phase B — admin-triggered LLM Q&A)
# =============================================================================
# Drives /api/admin/catalog/faq/generate. Same model used across all three
# entity types (category / idea / pain-point) in v1. Code-level fallback when
# unset: 'gpt-4o-mini'. Production should set explicitly so model swaps don't
# require a code release.
#
# Recommended:
#   - gpt-4o-mini   (~$0.0008/regenerate, fast)
#   - gpt-4.1-mini  (similar cost, better instruction-following)
#   - gpt-4o        (~$0.020/regenerate, best at nuanced rules)
OPENAI_FAQ_MODEL=gpt-4o-mini
FAQ_GENERATE_RATE_HOURLY=30
FAQ_SAVE_RATE_HOURLY=60

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================
NUM_SEARCH_QUERIES=40
MAX_SEARCH_RESULTS=20
MIN_REDDIT_UPVOTES=5
MIN_REDDIT_COMMENTS=3
MIN_COMMENT_LENGTH=50
MAX_REDDIT_CONTENT_TOKENS=400000
MIN_TWITTER_LIKES=5
MIN_TWITTER_REPLIES=3

# =============================================================================
# REDDIT FRESHNESS SEARCH
# =============================================================================
REDDIT_FRESHNESS_SEARCH_ENABLED=true
REDDIT_FRESHNESS_TBS=qdr:y
REDDIT_FRESHNESS_QUERY_FRACTION=0.3

# =============================================================================
# PRAW NATIVE REDDIT SEARCH
# =============================================================================
REDDIT_NATIVE_SEARCH_ENABLED=true
REDDIT_NATIVE_SEARCH_TIME_FILTER=month
REDDIT_NATIVE_SEARCH_QUERY_FRACTION=0.25
REDDIT_NATIVE_SEARCH_MAX_RESULTS=10

# =============================================================================
# TOKEN BUDGET FRESHNESS RESERVE
# =============================================================================
TOKEN_BUDGET_FRESHNESS_RESERVE=0.25
TOKEN_BUDGET_FRESHNESS_DAYS=180

# =============================================================================
# KEYWORD RESEARCH CONFIGURATION
# =============================================================================
KEYWORD_MIN_SEARCH_VOLUME=50
KEYWORD_MAX_COMPETITION=0.7
KEYWORD_RELEVANCE_THRESHOLD=0.5
TARGET_LOCATION=2840
TARGET_LANGUAGE=en
TOP_SOLUTIONS_FOR_VALIDATION=3
KEYWORD_MIN_VOLUME_THRESHOLD=10
KEYWORD_PIVOT_MAX_ATTEMPTS=4
KEYWORD_QUICK_EXPANSION_SIZE=50
KEYWORD_VALIDATION_TOP_PAIN_POINTS=5
KEYWORD_VALIDATION_TOP_COMPETITORS=10
KEYWORD_VALIDATION_TEMPERATURE=0.7
KEYWORD_ENRICHMENT_MIN_COVERAGE=0.30
KEYWORD_ENRICHMENT_TARGET_COVERAGE=0.60
KEYWORD_TIERING_MIN_COVERAGE=0.30

# =============================================================================
# GO/NO-GO VERDICT THRESHOLDS (defaults shown — uncomment to override)
# =============================================================================
# VERDICT_GO_AVG_SCORE=0.75
# VERDICT_GO_MIN_INDIVIDUAL_SCORE=0.60
# VERDICT_CONDITIONAL_AVG_SCORE=0.55
# VERDICT_CONDITIONAL_MIN_INDIVIDUAL_SCORE=0.50

# =============================================================================
# ANALYTICS (Frontend)
# =============================================================================
# Google Analytics GA4 (leave empty to disable analytics)
PUBLIC_GA_MEASUREMENT_ID=

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
VALIDATION_PARALLEL_ENABLED=true
KEYWORD_VALIDATION_MAX_WORKERS=3
KEYWORD_VALIDATION_BATCH_SIZE=50
THREAD_VALIDATION_MAX_WORKERS=4
